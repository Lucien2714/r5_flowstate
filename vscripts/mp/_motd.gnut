global function MOTD_Init

void function FireRemoteMotd( entity player )
{	
	thread
	(
		void function() : ( player )
		{
			if ( !player.p.isConnected )
				waitthread WaitSignalOrTimeout( player, 20, "OnConnected", "OnDestroy" )
			
			//(mk): Decided against late display, commenting the below.
			
			// WaitForGameState( eGameState.Playing )
			// WaitForChampionToFinish()
			
			if ( IsValid( player ) && player.p.isConnected )		
				Remote_CallFunction_UI( player, "UI_Callback_MOTD" )
		}
	)()
}

void function MOTD_Init()
{
    if ( GetCurrentPlaylistVarBool( "enable_motd", false ) )
    {
		#if DEVELOPER
			printl( "AddCallback_OnClientConnected( FireRemoteMotd )" )
		#endif
		
        AddCallback_OnClientConnected( FireRemoteMotd )
    }
}
